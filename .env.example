# =============================================================
# AI News Assistant - Environment Variables
# =============================================================
# 1. Copy this file and rename the copy to exactly: .env
# 2. Fill in the values below with your own keys.
# 3. Never commit your real .env file to Git or share it publicly.
# =============================================================

# Which AI provider to use: "openai" or "anthropic"
AI_PROVIDER=openai

# --- OpenAI settings (required if AI_PROVIDER=openai) ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic / Claude settings (required if AI_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- NewsAPI.org settings (always required) ---
NEWS_API_KEY=your_newsapi_key_here

# --- Flask settings ---
# Any random string works here - it's used to sign session cookies.
FLASK_SECRET_KEY=change_this_to_a_random_secret_string
FLASK_DEBUG=True
PORT=5000
